#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 dedsecorg
# agentic-route: declarative kernel policy-routing reconciler
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AR_JSON="${AGENTIC_ROUTE_CONF:-/etc/agentic-route/routes.json}"
export AR_JSON
source "$SCRIPT_DIR/lib/core.sh"

usage() {
  echo "Usage: agentic-route {enforce|check|status|monitor|daemon|diff|trace|api|api-handler|reconcile|mcp}" >&2
  exit 2
}

cmd_enforce() {
  AR_DIFF_MODE=enforce
  export AR_DIFF_MODE
  ar_apply_once >/dev/null
}

cmd_check() {
  AR_DIFF_MODE=check
  export AR_DIFF_MODE
  local drift
  drift=$(ar_apply_once)
  [ "$drift" -eq 0 ]
}

cmd_status() {
  echo "agentic-route status"
  echo "Spec: $AR_JSON"
  echo ""
  echo "--- Desired rules ---"
  jq -r '.rules[]? | "  \(.prio): \(.selector) \(.action)"' "$AR_JSON" 2>/dev/null
  echo ""
  echo "--- Live IPv4 rules ---"
  ar_rule_get | sed 's/^/  /'
  echo ""
  echo "--- Desired pinned routes ---"
  jq -r '.pinned_routes[]? | "  \(.dst) via \(.via // "-") dev \(.dev // "-")"' "$AR_JSON" 2>/dev/null
  echo "--- Live IPv4 routes ---"
  ar_route_get | sed 's/^/  /'
  echo ""
  echo "--- Drift ---"
  AR_DIFF_MODE=check
  export AR_DIFF_MODE
  ar_apply_once >/dev/null
}

cmd_reconcile() {
  exec /usr/local/bin/agentic-route-reconcile "$@"
}

cmd_daemon() {
  exec /usr/local/bin/agentic-route-daemon "$@"
}

cmd_monitor() {
  command -v ip >/dev/null 2>&1 || ar_die "ip command is required"
  ar_log "baseline reconcile"
  cmd_enforce
  ar_log "monitoring kernel rule, route, and link events"
  ip monitor rule route link 2>/dev/null | while IFS= read -r _event; do
    sleep 0.2
    cmd_enforce
    while IFS= read -r -t 0 _event; do :; done
  done
}

cmd_diff() {
  AR_DIFF_MODE=check
  export AR_DIFF_MODE
  local prio sa line
  echo "agentic-route diff"
  echo "Spec: $AR_JSON"
  echo ""
  echo "--- rules missing from live (would-add) ---"
  while IFS='|' read -r prio sa; do
    [ -z "$prio" ] && continue
    ar_rule_get | grep -qF "$(printf '%s	%s' "$prio" "$sa")" || printf '  + %s  %s
' "$prio" "$sa"
  done < <(jq -r '.rules[] | "\(.prio)|\(.selector) \(.action)"' "$AR_JSON" 2>/dev/null)
  echo "--- forbidden rules present (would-del) ---"
  local -a frb=()
  while IFS= read -r f; do [ -n "$f" ] && frb+=("$f"); done < <(jq -r '.forbidden_rules[]? | "\(.prio // 0)|\(.match)"' "$AR_JSON" 2>/dev/null)
  while IFS=$'	' read -r prio sa; do
    [ -z "$prio" ] && continue
    ar_spec_rule "$prio" | grep -qF -- "$sa" && continue
    local f fprio fmatch
    for f in "${frb[@]}"; do
      fprio="${f%%|*}"; fmatch="${f#*|}"
      [ "$fprio" != "0" ] && [ "$fprio" != "$prio" ] && continue
      if printf '%s' "$sa" | grep -qF -- "$fmatch"; then
        printf '  - %s  %s
' "$prio" "$sa"
        break
      fi
    done
  done < <(ar_rule_get)
  echo "--- pinned routes missing (would-replace) ---"
  while IFS=$'	' read -r dst via dev; do
    [ -z "$dst" ] && continue
    local dnorm line match=1
    dnorm="$(ar_dst_normalize "$dst")"
    while read -r line; do
      case "$line" in "$dnorm "*|"$dnorm") ;;
        *) continue ;;
      esac
      [ -n "$via" ] && ! printf '%s' "$line" | grep -qF -- "$via" && continue
      [ -n "$dev" ] && ! printf '%s' "$line" | grep -qF -- "$dev" && continue
      match=0; break
    done < <(ar_route_get)
    [ "$match" -eq 0 ] || printf '  ~ %s via %s dev %s
' "$dst" "${via:- -}" "${dev:-?}"
  done < <(jq -r '.pinned_routes[]? | [.dst, (.via // ""), (.dev // "")] | @tsv' "$AR_JSON" 2>/dev/null)
  echo ""
  echo "(read-only: run 'agentic-route enforce' to apply)"
}

cmd_trace() {
  local target="${1:-}"; [ -n "$target" ] || { echo "usage: agentic-route trace <target> [from <source>]" >&2; return 1; }
  local extra=()
  if [ "${2:-}" = "from" ] && [ -n "${3:-}" ]; then extra=(from "$3"); fi
  echo "agentic-route trace $target ${extra[*]}"
  ip route get "$target" "${extra[@]}" 2>&1
}

cmd_api() {
  local port="${AGENTIC_ROUTE_API_PORT:-8099}"
  # mTLS material: paths only, files live outside git. See docs/pki.md.
  local cert="${AGENTIC_ROUTE_TLS_CERT:-/etc/agentic-route/certs/api.crt}"
  local key="${AGENTIC_ROUTE_TLS_KEY:-/etc/agentic-route/certs/api.key}"
  local ca="${AGENTIC_ROUTE_TLS_CA:-/etc/agentic-route/certs/ca.crt}"
  if ! command -v socat >/dev/null 2>&1; then
    ar_die "socat (with OpenSSL) is required for api"
  fi
  local f
  for f in "$cert" "$key" "$ca"; do
    [ -r "$f" ] || ar_die "TLS material missing or unreadable: $f (see docs/pki.md)"
  done
  ar_log "API listening on :$port (mTLS, client CA: $ca)"
  # socat terminates TLS and verifies the client certificate against $ca
  # before api-handler is spawned, so /api/v1/enforce is unreachable without
  # a valid client cert. TLS 1.3 only so a PQ-capable OpenSSL (>= 3.5)
  # negotiates X25519MLKEM768 automatically.
  while true; do
    socat OPENSSL-LISTEN:"$port",reuseaddr,fork,cert="$cert",key="$key",cafile="$ca",verify=1,openssl-min-proto-version=TLS1.3 \
      SYSTEM:"$0 api-handler" 2>/dev/null
    sleep 1
  done
}

cmd_api_handler() {
  local path
  IFS=' ' read -r _ path _ || true
  printf 'HTTP/1.1 200 OK
Content-Type: application/json

'
  case "$path" in
    /api/v1/status) cmd_status 2>&1 | jq -Rs '{status:"ok", text: .}' ;;
    /api/v1/check)
      AR_DIFF_MODE=check
      export AR_DIFF_MODE
      local n
      n=$(ar_apply_once) || true
      jq -n --argjson n "$n" '{status:"ok", drift:$n}' ;;
    /api/v1/enforce)
      AR_DIFF_MODE=enforce
      export AR_DIFF_MODE
      local n
      n=$(ar_apply_once) || true
      jq -n --argjson n "$n" '{status:"ok", corrected:$n}' ;;
    /api/v1/diff)
      AR_DIFF_MODE=check
      export AR_DIFF_MODE
      local out
      out=$(cmd_diff 2>&1)
      printf '%s' "$out" | jq -Rs '{status:"ok", text:.}' ;;
    *)
      printf 'HTTP/1.1 404 Not Found
Content-Type: application/json

'
      jq -n '{error:"not found"}' ;;
  esac
}

# Read-only MCP server (JSON-RPC over stdio). Deliberately exposes no mutation
# tool: enforce/reconcile stay CLI/operator actions behind the mTLS REST API.
mcp_text_result() {
  local id="$1" text="$2"
  jq -cn --argjson id "$id" --arg text "$text" '{jsonrpc:"2.0",id:$id,result:{content:[{type:"text",text:$text}]}}'
}

mcp_error() {
  local id="$1" code="$2" msg="$3"
  jq -cn --argjson id "$id" --argjson code "$code" --arg msg "$msg" '{jsonrpc:"2.0",id:$id,error:{code:$code,message:$msg}}'
}

cmd_mcp() {
  command -v jq >/dev/null 2>&1 || ar_die "jq is required for mcp"
  ar_log "MCP server (read-only, stdio): route_status route_check route_diff route_trace"
  local line method req_id tool target src out
  while IFS= read -r line || [ -n "$line" ]; do
    [ -z "$line" ] && continue
    method=$(printf '%s' "$line" | jq -r '.method // empty' 2>/dev/null)
    req_id=$(printf '%s' "$line" | jq -c '.id // null' 2>/dev/null)
    [ -n "$req_id" ] || req_id=null
    case "$method" in
      initialize)
        jq -cn --argjson id "$req_id" '{jsonrpc:"2.0",id:$id,result:{protocolVersion:"2024-11-05",capabilities:{tools:{}},serverInfo:{name:"agentic-route",version:"1.0.0"}}}' ;;
      ping)
        jq -cn --argjson id "$req_id" '{jsonrpc:"2.0",id:$id,result:{}}' ;;
      notifications/*) ;;
      tools/list)
        jq -cn --argjson id "$req_id" '{jsonrpc:"2.0",id:$id,result:{tools:[
          {name:"route_status",description:"Desired vs live IPv4 rules/routes plus drift count (read-only)",inputSchema:{type:"object",properties:{},required:[]}},
          {name:"route_check",description:"Drift detection: reports whether live kernel state matches the spec (read-only)",inputSchema:{type:"object",properties:{},required:[]}},
          {name:"route_diff",description:"Precise would-add/would-del/would-replace diff, no mutation",inputSchema:{type:"object",properties:{},required:[]}},
          {name:"route_trace",description:"ip route get for a target, optionally from a source address",inputSchema:{type:"object",properties:{target:{type:"string",description:"Destination IP or hostname"},from:{type:"string",description:"Optional source address"}},required:["target"]}}
        ]}}' ;;
      tools/call)
        tool=$(printf '%s' "$line" | jq -r '.params.name // empty' 2>/dev/null)
        case "$tool" in
          route_status) out=$(cmd_status 2>&1); mcp_text_result "$req_id" "$out" ;;
          route_check)
            if cmd_check >/dev/null 2>&1; then out="in-sync: no drift"; else out="drift detected (run 'agentic-route diff' for detail)"; fi
            mcp_text_result "$req_id" "$out" ;;
          route_diff) out=$(cmd_diff 2>&1); mcp_text_result "$req_id" "$out" ;;
          route_trace)
            target=$(printf '%s' "$line" | jq -r '.params.arguments.target // empty' 2>/dev/null)
            src=$(printf '%s' "$line" | jq -r '.params.arguments.from // empty' 2>/dev/null)
            if [ -z "$target" ]; then mcp_error "$req_id" -32602 "route_trace requires 'target'"; continue; fi
            if [ -n "$src" ]; then out=$(cmd_trace "$target" from "$src" 2>&1); else out=$(cmd_trace "$target" 2>&1); fi
            mcp_text_result "$req_id" "$out" ;;
          *) mcp_error "$req_id" -32601 "Unknown tool: $tool" ;;
        esac ;;
      *) mcp_error "$req_id" -32601 "Method not supported: $method" ;;
    esac
  done
}

case "${1:-enforce}" in
  enforce) cmd_enforce ;;
  check)   cmd_check ;;
  status)  cmd_status ;;
  diff)    cmd_diff ;;
  trace)   cmd_trace "${@:2}" ;;
  monitor|daemon) cmd_monitor ;;
  api)     cmd_api ;;
  api-handler) cmd_api_handler ;;
  reconcile) cmd_reconcile "$@" ;;
  mcp)     cmd_mcp ;;
  -h|--help|help) usage ;;
  *) usage ;;
esac

