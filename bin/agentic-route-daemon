#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 dedsecorg
# agentic-route-daemon - event-driven reconciler with FIFO multiplexing
# Watches the intent file (AGENTIC_ROUTE_INTENT, default /etc/agentic-route/intent.json)
# via inotify on its directory, plus kernel routing (ip monitor)
# Runs agentic-route-reconcile on events with 200ms debounce

set -eo pipefail

RUN_DIR="/run/agentic-route"
FIFO="$RUN_DIR/events.fifo"
INTENT_FILE="${AGENTIC_ROUTE_INTENT:-/etc/agentic-route/intent.json}"
INTENT_DIR="$(dirname "$INTENT_FILE")"
INTENT_NAME="$(basename "$INTENT_FILE")"
RECONCILE_BIN="/usr/local/bin/agentic-route-reconcile"

mkdir -p "$RUN_DIR" "$INTENT_DIR"
[[ -p "$FIFO" ]] || mkfifo "$FIFO"

# Clean up children and FIFO on exit
trap 'exec 3>&-; kill $(jobs -p) 2>/dev/null; rm -f "$FIFO"' EXIT INT TERM

# Stream 1: Intent file changes (directory watch survives vim atomic rename)
inotifywait -m -q -e close_write,moved_to --format '%f' "$INTENT_DIR/" > "$FIFO" 2>/dev/null &

# Stream 2: Kernel routing changes (Netlink)
ip monitor rule route link 2>/dev/null > "$FIFO" &

# Hold FIFO open on FD 3 so it never receives EOF when writers restart
exec 3<> "$FIFO"

ar_log() { echo "[agentic-route-daemon] $*" >&2; }
ar_log "daemon started, watching $INTENT_FILE and kernel netlink"

# Unified debounced loop reading strictly from FD 3
while read -r event <&3; do
  # Drain burst events (200ms window)
  while read -r -t 0.2 -u 3 _; do :; done
  
  case "$event" in
    "$INTENT_NAME")
      ar_log "intent file changed: $event"
      ;;
    *)
      ar_log "kernel routing event"
      ;;
  esac
  
  # Run idempotent reconciliation
  if "$RECONCILE_BIN"; then
    :  # clean, no drift
  else
    ar_log "drift corrected"
  fi
done

ar_log "daemon stopped"

